# Kopie als .env anlegen und ausfüllen. .env nie committen.

# Datenbank (docker-compose setzt den Host "db")
GKB_DATABASE_URL=postgresql://gkb:gkb@db:5432/gkb
POSTGRES_PASSWORD=gkb

# Nextcloud – Dienstkonto mit App-Passwort, nur lesend
GKB_NEXTCLOUD_URL=https://cloud.example.de
GKB_NEXTCLOUD_USER=gkb-dienst
GKB_NEXTCLOUD_APP_PASSWORD=
# Ordner relativ zum Home des Dienstkontos, mehrere durch Komma getrennt
GKB_NEXTCLOUD_ROOTS=Projekte

# Ablage der Originale im Container
GKB_STORAGE_DIR=/data/originale

# Tresor für Pseudonyme: zwei zufällige Schlüssel erzeugen mit
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GKB_VAULT_KEY=
GKB_VAULT_HMAC_KEY=

# Pilot-Vereinfachung: Rechte-Partition = die ersten N Ordnerebenen unterhalb des Wurzelordners
GKB_PARTITION_DEPTH=1
