# Kopie als .env anlegen und ausfüllen. .env nie committen.

# Datenverzeichnis auf dem Server (verschlüsseltes Volume, siehe scripts/volume-verschluesseln.sh)
GKB_DATA_DIR=/srv/gkb-data

# Datenbank (docker-compose setzt den Host "db"). Passwort in beiden Zeilen gleich und zufällig wählen.
GKB_DATABASE_URL=postgresql://gkb:BITTE_AENDERN@db:5432/gkb
POSTGRES_PASSWORD=BITTE_AENDERN

# Nextcloud – Dienstkonto mit App-Passwort, nur lesend
GKB_NEXTCLOUD_URL=https://cloud.example.de
GKB_NEXTCLOUD_USER=gkb-dienst
GKB_NEXTCLOUD_APP_PASSWORD=
# Ordner relativ zum Home des Dienstkontos, mehrere durch Komma getrennt
GKB_NEXTCLOUD_ROOTS=Projekte

# Ablage der Originale im Container
GKB_STORAGE_DIR=/data/originale

# Tresor für Pseudonyme: zwei zufällige Schlüssel erzeugen mit
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GKB_VAULT_KEY=
GKB_VAULT_HMAC_KEY=

# Pilot-Vereinfachung: Rechte-Partition = die ersten N Ordnerebenen unterhalb des Wurzelordners
GKB_PARTITION_DEPTH=1

# --- Baustein 1b: Rechte ---------------------------------------------------------
# nextcloud = Freigaben + Gruppenordner auslesen, pfad = Fallback über Ordnerpfad
GKB_RECHTE_MODUS=nextcloud
# Optional, nur zum Lesen der Gruppenordner-Konfiguration (Admin-App-Passwort). Leer lassen,
# wenn keine Gruppenordner genutzt werden; mit ACL-Ordnern werden Inhalte sonst als
# "unvollständig" markiert und nur Administratoren angezeigt.
GKB_NEXTCLOUD_ADMIN_USER=
GKB_NEXTCLOUD_ADMIN_PASSWORD=

# --- Baustein 2: Aufbereitung ------------------------------------------------------
# LiteLLM-Modellname des kleinen Modells, z. B. "anthropic/<modell>" oder "ollama/<modell>"
GKB_MODELL_KLEIN=
# API-Schlüssel des Anbieters nach LiteLLM-Konvention, z. B. ANTHROPIC_API_KEY=
GKB_EMBEDDING_MODELL=intfloat/multilingual-e5-large
# Ordnerebenen unter dem Wurzelordner: 1 = Kunde, 2 = Projekt (0 = nicht auswerten)
GKB_KUNDE_EBENE=1
GKB_PROJEKT_EBENE=2

# --- GPU und lokales Modell (Hetzner GEX44) -------------------------------------------
# GPU-Erweiterung aktivieren (nach scripts/gpu-setup.sh):
# COMPOSE_FILE=docker-compose.yml:docker-compose.gpu.yml
#
# Lokales Modell über vLLM (Start: docker compose --profile lokal up -d llm):
#   GKB_MODELL_KLEIN=hosted_vllm/gkb-lokal
#   GKB_MODELL_KLEIN_API_BASE=http://llm:8000/v1
GKB_MODELL_KLEIN_API_BASE=
# Startvorschlag für 20 GB: 7B-Modell, 4-bit (AWQ). Neben Docling/Embeddings: Anteil 0.6.
# Läuft vLLM allein (sync vorher abgeschlossen), passt mit Anteil 0.85 auch ein 14B-Modell (AWQ).
GKB_LLM_MODELL=Qwen/Qwen2.5-7B-Instruct-AWQ
GKB_LLM_GPU_ANTEIL=0.6
GKB_LLM_MAX_LEN=16384
GKB_LLM_PARALLEL=8
# Nur nötig für zugangsbeschränkte Modelle auf Hugging Face
HF_TOKEN=
